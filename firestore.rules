rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Por defecto, denegar todo acceso no autenticado o no autorizado
    match /{document=**} {
      allow read, write: if false;
    }

    // Seguridad estricta por usuario: Solo el propio usuario autenticado puede leer o escribir sus datos
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcolección de seguimiento emocional privado
      match /emociones/{emocionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.nivel is number
          && request.resource.data.nivel >= 1 
          && request.resource.data.nivel <= 10;
      }

      // Subcolección de arte terapia
      match /dibujos/{dibujoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección de tokens para notificaciones push
      match /push_tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
